{# Task item partial - reusable component for task display #}
{# Expects: task (Task entity), taskSpacing (optional, from parent context) #}

<div data-task-item
     data-task-id="{{ task.id }}"
     class="bg-white dark:bg-gray-800 shadow dark:shadow-none ring-1 ring-gray-200/50 dark:ring-gray-700 rounded-lg {{ taskSpacing|default('comfortable') == 'compact' ? 'px-4 py-2' : 'p-4' }} hover:shadow-md dark:hover:ring-gray-600 transition-shadow duration-200 {% if overdueInfo is defined and overdueInfo.isOverdue %}{{ overdueInfo.borderClass }}{% elseif task.isOverdue %}border-l-4 border-l-red-500{% elseif task.dueDate and not task.isCompleted and task.dueDate|date('Y-m-d') == 'now'|date('Y-m-d') %}border-l-4 border-l-yellow-500{% endif %}"
     :class="{ 'relative z-50': actionsMenuOpen || statusDropdownOpen || priorityDropdownOpen || dueDateDropdownOpen || projectDropdownOpen }"
     x-data="taskItem('{{ task.id }}', '{{ task.status }}', {{ task.priority }}, '{{ task.dueDate ? task.dueDate|date('Y-m-d') : '' }}', '{{ task.dueTime ? task.dueTime|date('H:i') : '' }}', '{{ task.project ? task.project.id : '' }}', '{{ task.project ? task.project.name|e('js') : '' }}', '{{ task.project ? task.project.color|default('#808080') : '' }}')"
     @closeAll.window="showDeleteModal = false; actionsMenuOpen = false; statusDropdownOpen = false; priorityDropdownOpen = false; dueDateDropdownOpen = false; projectDropdownOpen = false"
     @toggle-subtasks.window="if ($event.detail.taskId === '{{ task.id }}') { $store.subtasks?.toggle('{{ task.id }}') }"
     tabindex="-1">
    <div class="flex items-start justify-between">
        <div class="flex-1 min-w-0">
            {# Task title and status #}
            <div class="flex items-center gap-3">
                {# Issue #59: AJAX status toggle - no page refresh #}
                <button type="button"
                        @click="toggleStatus()"
                        :disabled="isUpdating"
                        class="flex-shrink-0 min-h-10 min-w-10 sm:min-h-0 sm:min-w-0 h-6 w-6 sm:h-5 sm:w-5 rounded-full transition-colors flex items-center justify-center"
                        :class="status === 'completed'
                            ? 'bg-green-500 hover:bg-green-600'
                            : status === 'in_progress'
                                ? 'border-2 border-blue-500 bg-blue-50 dark:bg-blue-900/30 hover:border-green-500 hover:bg-green-50 dark:hover:bg-green-900/30'
                                : 'border-2 border-gray-300 dark:border-gray-600 hover:border-green-500 hover:bg-green-50 dark:hover:bg-green-900/30'"
                        :title="status === 'completed' ? 'Mark as pending' : 'Mark as completed'">
                    <svg x-show="status === 'completed'" class="w-4 h-4 sm:w-3 sm:h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </button>

                {# Title - reactive strikethrough based on status #}
                <h3 class="text-sm font-medium line-clamp-3"
                    :class="status === 'completed' ? 'line-through text-gray-500 dark:text-gray-400' : 'text-gray-900 dark:text-gray-100'">
                    {{ task.title }}
                </h3>
            </div>

            {# Task meta info - Issue #63: horizontal layout on all screens #}
            <div class="mt-2 flex flex-row flex-wrap items-center gap-1.5 sm:gap-2 ml-3 sm:ml-9">
                {# Status badge - clickable dropdown for inline status editing (Issue #108) #}
                <div class="relative inline-flex">
                    <button type="button"
                            @click.stop="statusDropdownOpen = !statusDropdownOpen; priorityDropdownOpen = false; dueDateDropdownOpen = false; projectDropdownOpen = false; actionsMenuOpen = false"
                            :disabled="isUpdating"
                            aria-haspopup="true"
                            :aria-expanded="statusDropdownOpen"
                            class="items-center rounded-full px-2.5 py-0.5 text-xs font-medium cursor-pointer hover:ring-2 hover:ring-offset-1 dark:hover:ring-offset-gray-800 transition-shadow"
                            :class="{
                                'hidden sm:inline-flex bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300 hover:ring-gray-300 dark:hover:ring-gray-600': status === 'pending',
                                'inline-flex bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300 hover:ring-blue-300 dark:hover:ring-blue-700': status === 'in_progress',
                                'inline-flex bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 hover:ring-green-300 dark:hover:ring-green-700': status === 'completed'
                            }"
                            :title="'Status: ' + (status === 'pending' ? 'Pending' : status === 'in_progress' ? 'In Progress' : 'Completed') + ' - Click to change'"
                            x-text="status === 'pending' ? 'Pending' : status === 'in_progress' ? 'In Progress' : 'Completed'">
                    </button>

                    {# Status dropdown #}
                    <div x-show="statusDropdownOpen"
                         x-cloak
                         @click.away="statusDropdownOpen = false"
                         @keydown.escape.stop="statusDropdownOpen = false"
                         role="menu"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 z-20 mt-1 w-40 origin-top-left rounded-md bg-white dark:bg-gray-800 shadow-lg ring-1 ring-black ring-opacity-5 dark:ring-gray-700 py-1">
                        <button type="button" @click="setStatus('pending'); statusDropdownOpen = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-700" :class="status === 'pending' ? 'bg-gray-100 dark:bg-gray-600' : ''">
                            <span class="inline-block w-3 h-3 rounded-full bg-gray-400"></span>
                            <span class="text-gray-700 dark:text-gray-300">Pending</span>
                        </button>
                        <button type="button" @click="setStatus('in_progress'); statusDropdownOpen = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-700" :class="status === 'in_progress' ? 'bg-gray-100 dark:bg-gray-600' : ''">
                            <span class="inline-block w-3 h-3 rounded-full bg-blue-400"></span>
                            <span class="text-gray-700 dark:text-gray-300">In Progress</span>
                        </button>
                        <button type="button" @click="setStatus('completed'); statusDropdownOpen = false" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-700" :class="status === 'completed' ? 'bg-gray-100 dark:bg-gray-600' : ''">
                            <span class="inline-block w-3 h-3 rounded-full bg-green-400"></span>
                            <span class="text-gray-700 dark:text-gray-300">Completed</span>
                        </button>
                    </div>
                </div>

                {# Issue #34: Priority badge with semantic colors #}
                {# Issue #61: Inline priority editing #}
                <div class="relative inline-flex">
                    <button type="button"
                            @click.stop="priorityDropdownOpen = !priorityDropdownOpen; statusDropdownOpen = false; dueDateDropdownOpen = false; projectDropdownOpen = false; actionsMenuOpen = false"
                            :disabled="isUpdating"
                            aria-haspopup="true"
                            :aria-expanded="priorityDropdownOpen"
                            class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium cursor-pointer hover:ring-2 hover:ring-offset-1 dark:hover:ring-offset-gray-800 transition-shadow"
                            :class="{
                                'bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-300 hover:ring-red-300 dark:hover:ring-red-700': priority === 1,
                                'bg-orange-100 dark:bg-orange-900/30 text-orange-800 dark:text-orange-300 hover:ring-orange-300 dark:hover:ring-orange-700': priority === 2,
                                'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-800 dark:text-yellow-300 hover:ring-yellow-300 dark:hover:ring-yellow-700': priority === 3,
                                'bg-blue-100 dark:bg-blue-900/30 text-blue-800 dark:text-blue-300 hover:ring-blue-300 dark:hover:ring-blue-700': priority === 4,
                                'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 hover:ring-gray-300 dark:hover:ring-gray-600': priority === 5
                            }"
                            :title="'Priority: P' + priority + ' - Click to change'">
                        <span x-text="'P' + priority"></span>
                    </button>

                    {# Priority dropdown #}
                    <div x-show="priorityDropdownOpen"
                         x-cloak
                         @click.away="priorityDropdownOpen = false"
                         @keydown.escape.stop="priorityDropdownOpen = false"
                         role="menu"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 z-20 mt-1 w-36 origin-top-left rounded-md bg-white dark:bg-gray-800 shadow-lg ring-1 ring-black ring-opacity-5 dark:ring-gray-700 py-1">
                        <button type="button" @click="setPriority(1)" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-700" :class="priority === 1 ? 'bg-gray-100 dark:bg-gray-600' : ''">
                            <span class="inline-block w-3 h-3 rounded-full bg-red-500"></span>
                            <span class="text-gray-700 dark:text-gray-300">P1 - Urgent</span>
                        </button>
                        <button type="button" @click="setPriority(2)" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-700" :class="priority === 2 ? 'bg-gray-100 dark:bg-gray-600' : ''">
                            <span class="inline-block w-3 h-3 rounded-full bg-orange-500"></span>
                            <span class="text-gray-700 dark:text-gray-300">P2 - High</span>
                        </button>
                        <button type="button" @click="setPriority(3)" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-700" :class="priority === 3 ? 'bg-gray-100 dark:bg-gray-600' : ''">
                            <span class="inline-block w-3 h-3 rounded-full bg-yellow-500"></span>
                            <span class="text-gray-700 dark:text-gray-300">P3 - Medium</span>
                        </button>
                        <button type="button" @click="setPriority(4)" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-700" :class="priority === 4 ? 'bg-gray-100 dark:bg-gray-600' : ''">
                            <span class="inline-block w-3 h-3 rounded-full bg-blue-500"></span>
                            <span class="text-gray-700 dark:text-gray-300">P4 - Low</span>
                        </button>
                        <button type="button" @click="setPriority(5)" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-700" :class="priority === 5 ? 'bg-gray-100 dark:bg-gray-600' : ''">
                            <span class="inline-block w-3 h-3 rounded-full bg-gray-400"></span>
                            <span class="text-gray-700 dark:text-gray-300">P5 - Lowest</span>
                        </button>
                    </div>
                </div>

                {# Due date #}
                {# Issue #61: Inline due date editing #}
                <div class="relative inline-flex">
                    <button type="button"
                            @click.stop="dueDateDropdownOpen = !dueDateDropdownOpen; statusDropdownOpen = false; priorityDropdownOpen = false; projectDropdownOpen = false; actionsMenuOpen = false"
                            :disabled="isUpdating"
                            aria-haspopup="true"
                            :aria-expanded="dueDateDropdownOpen"
                            class="inline-flex items-center gap-1 text-xs cursor-pointer hover:bg-gray-100 dark:hover:bg-gray-700 rounded px-1.5 py-0.5 -mx-1.5 transition-colors"
                            :class="dueDate && new Date(dueDate + 'T23:59:59') < new Date() && status !== 'completed' ? 'text-red-600 dark:text-red-400' : (dueDate === new Date().toISOString().slice(0, 10) && status !== 'completed' ? 'text-yellow-600 dark:text-yellow-500' : 'text-gray-500 dark:text-gray-400')"
                            :title="dueDate ? 'Due: ' + dueDate + ' - Click to change' : 'Set due date'">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        <template x-if="dueDate">
                            <span>
                                <template x-if="!(dueDate === new Date().toISOString().slice(0, 10) && !(new Date(dueDate + 'T23:59:59') < new Date()) && status !== 'completed')">
                                    <span>
                                        <span x-text="new Date(dueDate + 'T00:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })"></span>
                                        <template x-if="dueTime">
                                            <span x-text="' at ' + new Date('2000-01-01T' + dueTime).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })"></span>
                                        </template>
                                        <template x-if="dueDate && new Date(dueDate + 'T23:59:59') < new Date() && status !== 'completed'">
                                            <span class="font-medium">(Overdue)</span>
                                        </template>
                                    </span>
                                </template>
                                <template x-if="dueDate === new Date().toISOString().slice(0, 10) && !(new Date(dueDate + 'T23:59:59') < new Date()) && status !== 'completed'">
                                    <span class="font-medium text-yellow-600 dark:text-yellow-500">Due Today<template x-if="dueTime"><span class="font-normal" x-text="' at ' + new Date('2000-01-01T' + dueTime).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })"></span></template></span>
                                </template>
                            </span>
                        </template>
                        <template x-if="!dueDate">
                            <span class="text-gray-400 dark:text-gray-500">+ Due</span>
                        </template>
                    </button>

                    {# Due date dropdown #}
                    <div x-show="dueDateDropdownOpen"
                         x-cloak
                         @click.away="dueDateDropdownOpen = false"
                         @keydown.escape.stop="dueDateDropdownOpen = false"
                         role="menu"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 z-20 mt-1 w-52 origin-top-left rounded-md bg-white dark:bg-gray-800 shadow-lg ring-1 ring-black ring-opacity-5 dark:ring-gray-700 py-1">
                        {# Quick options #}
                        <div class="px-3 py-1.5 text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Quick set</div>
                        <button type="button" @click="setDueDate(getQuickDate('today'), null)" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                            Today
                        </button>
                        <button type="button" @click="setDueDate(getQuickDate('tomorrow'), null)" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
                            Tomorrow
                        </button>
                        <button type="button" @click="setDueDate(getQuickDate('nextWeek'), null)" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Next week
                        </button>

                        <div class="border-t dark:border-gray-700 my-1"></div>

                        {# Custom date/time picker #}
                        <div class="px-3 py-2 space-y-2">
                            <div>
                                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Date</label>
                                <input type="date"
                                       x-model="dueDate"
                                       class="block w-full rounded border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 text-xs py-1 focus:border-teal-500 focus:ring-teal-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Time (optional)</label>
                                <input type="time"
                                       x-model="dueTime"
                                       class="block w-full rounded border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 text-xs py-1 focus:border-teal-500 focus:ring-teal-500">
                            </div>
                            <button type="button"
                                    @click="setDueDate(dueDate, dueTime)"
                                    :disabled="!dueDate"
                                    class="w-full rounded bg-teal-600 px-2 py-1 text-xs font-medium text-white hover:bg-teal-500 disabled:opacity-50 disabled:cursor-not-allowed">
                                Set Date
                            </button>
                        </div>

                        <template x-if="dueDate">
                            <div>
                                <div class="border-t dark:border-gray-700 my-1"></div>
                                <button type="button" @click="setDueDate(null, null)" class="flex w-full items-center gap-2 px-3 py-1.5 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                    Clear due date
                                </button>
                            </div>
                        </template>
                    </div>
                </div>

                {# Project badge #}
                {# Issue #61: Inline project editing #}
                <div class="relative inline-flex">
                    <button type="button"
                            @click.stop="openProjectDropdown()"
                            :disabled="isUpdating"
                            aria-haspopup="true"
                            :aria-expanded="projectDropdownOpen"
                            class="inline-flex items-center gap-1 text-xs rounded-full px-2 py-0.5 cursor-pointer transition-colors"
                            :class="projectId ? 'text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600' : 'text-gray-400 dark:text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700'"
                            :title="projectId ? 'Project: ' + projectName + ' - Click to change' : 'Set project'">
                        <template x-if="projectId && projectColor">
                            <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" :style="'background-color: ' + projectColor"></span>
                        </template>
                        <template x-if="!projectId">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                            </svg>
                        </template>
                        <span x-text="projectName || '+ Project'"></span>
                    </button>

                    {# Project dropdown #}
                    <div x-show="projectDropdownOpen"
                         x-cloak
                         @click.away="projectDropdownOpen = false"
                         @keydown.escape.stop="projectDropdownOpen = false"
                         role="menu"
                         x-transition:enter="transition ease-out duration-100"
                         x-transition:enter-start="transform opacity-0 scale-95"
                         x-transition:enter-end="transform opacity-100 scale-100"
                         x-transition:leave="transition ease-in duration-75"
                         x-transition:leave-start="transform opacity-100 scale-100"
                         x-transition:leave-end="transform opacity-0 scale-95"
                         class="absolute left-0 z-20 mt-1 w-48 origin-top-left rounded-md bg-white dark:bg-gray-800 shadow-lg ring-1 ring-black ring-opacity-5 dark:ring-gray-700 py-1 max-h-64 overflow-y-auto">
                        {# Loading state #}
                        <template x-if="!projectsLoaded">
                            <div class="px-3 py-2 text-sm text-gray-500 dark:text-gray-400 flex items-center gap-2">
                                <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                                </svg>
                                Loading...
                            </div>
                        </template>

                        <template x-if="projectsLoaded">
                            <div>
                                {# No project option #}
                                <button type="button"
                                        @click="setProject('', '', '')"
                                        class="flex w-full items-center gap-2 px-3 py-1.5 text-sm hover:bg-gray-100 dark:hover:bg-gray-700"
                                        :class="!projectId ? 'bg-gray-100 dark:bg-gray-600' : ''">
                                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                    <span class="text-gray-500 dark:text-gray-400">No Project</span>
                                </button>

                                <div class="border-t dark:border-gray-700 my-1"></div>

                                {# Project list #}
                                <template x-for="proj in projects" :key="proj.id">
                                    <button type="button"
                                            @click="setProject(proj.id, proj.name, proj.color)"
                                            class="flex w-full items-center gap-2 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700"
                                            :class="projectId === proj.id ? 'bg-gray-100 dark:bg-gray-600' : ''"
                                            :style="'padding-left: ' + (12 + (proj.depth || 0) * 16) + 'px; padding-right: 12px'">
                                        <span class="w-3 h-3 rounded-full flex-shrink-0" :style="'background-color: ' + (proj.color || '#808080')"></span>
                                        <span x-text="proj.name"></span>
                                    </button>
                                </template>

                                {# Empty state #}
                                <template x-if="projects.length === 0">
                                    <div class="px-3 py-2 text-sm text-gray-500 dark:text-gray-400">
                                        No projects available
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </div>

                {# Recurring indicator #}
                {% if task.isRecurring %}
                    <span class="inline-flex items-center gap-1 text-xs text-gray-500 dark:text-gray-400" title="{{ task.recurrenceRule ?: 'Recurring task' }}">
                        {# Arrow-path icon (Heroicons) #}
                        <svg class="w-4 h-4 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        <span class="sr-only">Recurring: {{ task.recurrenceRule }}</span>
                    </span>
                {% endif %}

                {# Issue #44: Subtask button - always visible for discoverability #}
                {% set subtasks = task.subtasks %}
                {% set subtaskCount = subtasks|length %}
                {% if subtaskCount > 0 %}
                    {% set completedSubtasks = subtasks|filter(s => s.status == 'completed')|length %}
                    {% set progressPercent = ((completedSubtasks / subtaskCount) * 100)|round %}
                    <button type="button"
                            @click="$dispatch('toggle-subtasks', { taskId: '{{ task.id }}' })"
                            class="inline-flex items-center gap-1 rounded-full bg-gray-100 dark:bg-gray-700 px-2 py-0.5 text-xs font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
                            title="{{ completedSubtasks }}/{{ subtaskCount }} subtasks completed">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
                        </svg>
                        {{ completedSubtasks }}/{{ subtaskCount }}
                        {# Progress bar #}
                        <span class="inline-block w-12 h-1.5 bg-gray-200 dark:bg-gray-600 rounded-full overflow-hidden ml-1">
                            <span class="block h-full bg-green-500 rounded-full transition-all duration-300" style="width: {{ progressPercent }}%"></span>
                        </span>
                        {# Chevron icon #}
                        <svg class="w-3 h-3 transition-transform" :class="{ 'rotate-180': $store.subtasks?.expanded?.['{{ task.id }}'] }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>
                {% else %}
                    {# Issue #44: Add subtask button shown when no subtasks exist #}
                    <button type="button"
                            @click="$dispatch('toggle-subtasks', { taskId: '{{ task.id }}' })"
                            class="inline-flex items-center gap-1 rounded-full bg-gray-50 dark:bg-gray-700 px-2 py-0.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-600 hover:text-gray-700 dark:hover:text-gray-300 transition-colors"
                            title="Add subtask">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                        </svg>
                        Subtask
                    </button>
                {% endif %}
            </div>

            {# Description preview #}
            {% if task.description %}
                <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 line-clamp-2 ml-9">{{ task.description }}</p>
            {% endif %}

            {# Issue #112: Active subtasks always visible #}
            {% set activeSubtasks = subtasks|filter(s => s.status != 'completed') %}
            {% set completedSubtaskList = subtasks|filter(s => s.status == 'completed') %}

            {% if activeSubtasks|length > 0 %}
                <div class="mt-3 ml-3 sm:ml-9 space-y-1.5 border-l-2 border-gray-200 dark:border-gray-600 pl-3">
                    {% for subtask in activeSubtasks %}
                        <div class="flex items-center gap-2 py-1"
                             data-subtask-id="{{ subtask.id }}"
                             x-data="{ status: '{{ subtask.status }}', updating: false }">
                            <button type="button"
                                    @click="
                                        if (updating) return;
                                        updating = true;
                                        window.api.patch('/api/v1/tasks/{{ subtask.id }}', { status: 'completed' })
                                            .then(r => r.json())
                                            .then(data => { if (data.success) window.location.reload(); })
                                            .finally(() => updating = false);
                                    "
                                    :disabled="updating"
                                    class="flex-shrink-0 h-4 w-4 rounded border border-gray-300 dark:border-gray-500 hover:border-green-400 flex items-center justify-center transition-colors"
                                    title="Mark as completed">
                            </button>
                            <span class="text-sm text-gray-700 dark:text-gray-300">
                                {{ subtask.title }}
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {# Issue #112: Completed subtasks + add form behind toggle #}
            <div x-show="$store.subtasks?.expanded?.['{{ task.id }}']"
                 x-cloak
                 x-transition:enter="transition ease-out duration-200"
                 x-transition:enter-start="opacity-0 -translate-y-2"
                 x-transition:enter-end="opacity-100 translate-y-0"
                 x-transition:leave="transition ease-in duration-150"
                 x-transition:leave-start="opacity-100 translate-y-0"
                 x-transition:leave-end="opacity-0 -translate-y-2"
                 class="mt-3 ml-3 sm:ml-9 space-y-2"
                 data-subtasks-container="{{ task.id }}">

                {% if completedSubtaskList|length > 0 %}
                <div class="space-y-1.5 border-l-2 border-gray-200 dark:border-gray-600 pl-3">
                    {% for subtask in completedSubtaskList %}
                        <div class="flex items-center gap-2 py-1"
                             data-subtask-id="{{ subtask.id }}"
                             x-data="{ status: 'completed', updating: false }">
                            <button type="button"
                                    @click="
                                        if (updating) return;
                                        updating = true;
                                        window.api.patch('/api/v1/tasks/{{ subtask.id }}', { status: 'pending' })
                                            .then(r => r.json())
                                            .then(data => { if (data.success) window.location.reload(); })
                                            .finally(() => updating = false);
                                    "
                                    :disabled="updating"
                                    class="flex-shrink-0 h-4 w-4 rounded border bg-green-500 border-green-500 flex items-center justify-center transition-colors"
                                    title="Mark as pending">
                                <svg class="w-2.5 h-2.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </button>
                            <span class="text-sm text-gray-400 dark:text-gray-500 line-through">
                                {{ subtask.title }}
                            </span>
                        </div>
                    {% endfor %}
                </div>
                {% endif %}

                {# Inline subtask creation form - uses window.api for session auth #}
                <form class="flex items-center gap-2 {% if completedSubtaskList|length > 0 %}pl-3{% endif %}"
                      x-data="{ title: '', submitting: false }"
                      @submit.prevent="
                          if (!title.trim() || submitting) return;
                          submitting = true;
                          window.api.post('/api/v1/tasks/{{ task.id }}/subtasks', { title: title })
                              .then(r => r.json())
                              .then(data => {
                                  if (data.success) {
                                      window.location.reload();
                                  }
                              })
                              .finally(() => submitting = false);
                      ">
                    <div class="flex-shrink-0 h-4 w-4 rounded border border-dashed border-gray-300 dark:border-gray-500"></div>
                    <input type="text"
                           x-model="title"
                           placeholder="Add subtask..."
                           class="flex-1 text-sm border-0 border-b border-transparent focus:border-teal-500 focus:ring-0 py-1 px-0 placeholder-gray-400 dark:placeholder-gray-500 bg-transparent dark:text-gray-100"
                           :disabled="submitting">
                    <button type="submit"
                            class="text-xs text-teal-600 hover:text-teal-800 font-medium disabled:opacity-50"
                            :disabled="!title.trim() || submitting">
                        Add
                    </button>
                </form>
            </div>
        </div>

        {# Actions dropdown #}
        <div class="flex-shrink-0 ml-4">
            <div class="relative">
                <button @click="actionsMenuOpen = !actionsMenuOpen; statusDropdownOpen = false; priorityDropdownOpen = false; dueDateDropdownOpen = false; projectDropdownOpen = false" type="button" aria-haspopup="true" :aria-expanded="actionsMenuOpen" class="min-h-11 min-w-11 sm:min-h-0 sm:min-w-0 inline-flex items-center justify-center rounded-md bg-white dark:bg-gray-800 px-2 py-1 text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800">
                    <span class="sr-only">Open task menu</span>
                    <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10 3a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM10 8.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM11.5 15.5a1.5 1.5 0 10-3 0 1.5 1.5 0 003 0z" />
                    </svg>
                </button>

                <div x-show="actionsMenuOpen"
                     x-cloak
                     @click.away="actionsMenuOpen = false"
                     @keydown.escape.stop="actionsMenuOpen = false"
                     role="menu"
                     x-transition:enter="transition ease-out duration-100"
                     x-transition:enter-start="transform opacity-0 scale-95"
                     x-transition:enter-end="transform opacity-100 scale-100"
                     x-transition:leave="transition ease-in duration-75"
                     x-transition:leave-start="transform opacity-100 scale-100"
                     x-transition:leave-end="transform opacity-0 scale-95"
                     class="absolute right-0 z-10 mt-2 w-48 origin-top-right rounded-md bg-white dark:bg-gray-800 py-1 shadow-lg ring-1 ring-black ring-opacity-5 dark:ring-gray-700 focus:outline-none">

                    {# Issue #35: Edit Task button #}
                    <button @click="actionsMenuOpen = false; $dispatch('open-edit-modal', { taskId: '{{ task.id }}' })"
                            type="button"
                            class="block w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                        <span class="inline-flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                            Edit Task
                        </span>
                    </button>

                    <div class="border-t dark:border-gray-700 my-1"></div>

                    {# Delete button #}
                    <button @click="actionsMenuOpen = false; showDeleteModal = true" type="button" class="block w-full text-left px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30">
                        Delete Task
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Delete confirmation modal #}
    <div x-show="showDeleteModal"
         x-cloak
         class="fixed inset-0 z-50 overflow-y-auto"
         aria-labelledby="modal-title"
         role="dialog"
         aria-modal="true">
        <div class="flex min-h-screen items-end justify-center px-4 pb-20 pt-4 text-center sm:block sm:p-0">
            {# Background overlay #}
            <div x-show="showDeleteModal"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0"
                 x-transition:enter-end="opacity-100"
                 x-transition:leave="ease-in duration-200"
                 x-transition:leave-start="opacity-100"
                 x-transition:leave-end="opacity-0"
                 @click="showDeleteModal = false"
                 class="fixed inset-0 bg-gray-500 bg-opacity-75 dark:bg-gray-900/80 transition-opacity"></div>

            <span class="hidden sm:inline-block sm:h-screen sm:align-middle" aria-hidden="true">&#8203;</span>

            {# Modal panel #}
            <div x-show="showDeleteModal"
                 x-transition:enter="ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave="ease-in duration-200"
                 x-transition:leave-start="opacity-100 translate-y-0 sm:scale-100"
                 x-transition:leave-end="opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
                 class="relative inline-block transform overflow-hidden rounded-lg bg-white dark:bg-gray-800 px-4 pb-4 pt-5 text-left align-bottom shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg sm:p-6 sm:align-middle">
                <div class="sm:flex sm:items-start">
                    <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 dark:bg-red-900/30 sm:mx-0 sm:h-10 sm:w-10">
                        <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                        </svg>
                    </div>
                    <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                        <h3 class="text-base font-semibold leading-6 text-gray-900 dark:text-gray-100" id="modal-title">Delete Task</h3>
                        <div class="mt-2">
                            <p class="text-sm text-gray-500 dark:text-gray-400">Are you sure you want to delete "{{ task.title }}"? This action cannot be undone.</p>
                        </div>
                    </div>
                </div>
                <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
                    <form action="{{ path('app_task_delete', {id: task.id}) }}" method="POST" class="inline">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_task_' ~ task.id) }}">
                        <button type="submit" class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:ml-3 sm:w-auto">Delete</button>
                    </form>
                    <button @click="showDeleteModal = false" type="button" class="mt-3 inline-flex w-full justify-center rounded-md bg-white dark:bg-gray-700 px-3 py-2 text-sm font-semibold text-gray-900 dark:text-gray-100 shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-gray-600 hover:bg-gray-50 dark:hover:bg-gray-600 sm:mt-0 sm:w-auto">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</div>
